# Bu dosyayi `.env` olarak kopyala.
# SQLite dosya tabanli calisir, ek bir veritabani kurulumu gerekmez.
# Yol `backend/` klasorune goredir; nereden baslatildigina bagli degildir.
DATABASE_URL="sqlite:///./dev.db"

# Uretimde mutlaka guclu/rastgele bir deger ile degistirilmeli.
JWT_SECRET="yerel-gelistirme-icin-degistir-bunu"

PORT=3000
