# Bu dosyayı `.env` olarak kopyala ve kendi yerel değerlerini gir.
# `EXPO_PUBLIC_` önekli değişkenler Expo tarafından otomatik olarak build'e
# gömülür (ek bir kurulum gerekmez) — bu yüzden buraya gizli/hassas bir
# anahtar KONULMAZ, sadece istemci tarafında bilinmesi güvenli değerler girilir.

# Faz 1 Express backend'inin adresi (henüz ayrı bir repo/servis olarak
# deploy edilmedi; backend hazır olana kadar services/mockApi.ts kullanılıyor).
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
